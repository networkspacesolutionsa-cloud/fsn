{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name you choose in the Cloudflare dashboard
  "name": "netspacesol",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Every page is prerendered (scripts/prerender.mjs): unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page",
    // Clean URLs: /services/cctv-cameras/ serves dist/services/cctv-cameras/index.html.
    // The Google verification file keeps its exact .html URL through public/_redirects.
    "html_handling": "auto-trailing-slash"
  }
}
